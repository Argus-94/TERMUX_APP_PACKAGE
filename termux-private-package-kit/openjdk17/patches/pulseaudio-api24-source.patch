-	if [ $TERMUX_PKG_API_LEVEL -lt 26 ]; then
-		local _libdir="$TERMUX_PKG_TMPDIR/libaaudio"
-		rm -rf "${_libdir}"
-		mkdir -p "${_libdir}"
-		cp "$TERMUX_STANDALONE_TOOLCHAIN/sysroot/usr/lib/$TERMUX_HOST_PLATFORM/26/libaaudio.so" \
-			"${_libdir}"
